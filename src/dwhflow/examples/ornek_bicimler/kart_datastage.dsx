    GUNCELLEME_ZAMANI = CURRENT_TIMESTAMP
WHERE ISLEM_ID = ORCHESTRATE.ISLEM_ID]]></UpdateStatement><InsertStatement modified='1' type='string'><![CDATA[INSERT INTO #pOdsDb#.ODS_KART_ISLEM
